{
  "name": "fdm-material-advisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kostenloser, quelloffener FDM-Materialberater: welches 3D-Druck-Material passt zum Anwendungsfall - und warum. Offene Materialdatenbank mit Quellen und Konfidenzangaben.",
  "license": "MIT",
  "homepage": "https://reents3d.github.io/fdm-material-advisor/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Reents3D/fdm-material-advisor.git"
  },
  "exports": {
    "./engine": "./src/engine/index.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-seo.mjs && node scripts/export-csv.mjs && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "npm run validate:schema && npm run validate:plausibility",
    "validate:schema": "node scripts/validate-schema.mjs",
    "validate:plausibility": "node scripts/validate-data.mjs",
    "import:bambu": "node scripts/import/bambu-tds.mjs",
    "export:csv": "node scripts/export-csv.mjs",
    "ci": "npm run validate && npm run typecheck && npm run test && npm run build",
    "import:extrudr": "node scripts/import/extrudr.mjs",
    "import:azurefilm": "node scripts/import/azurefilm.mjs",
    "import:manufacturers": "node scripts/import/manufacturer-products.mjs",
    "import:all": "npm run import:bambu && npm run import:manufacturers && npm run import:extrudr && npm run import:azurefilm && npm run import:3djake && npm run import:m4p && node scripts/import/bambu-products.mjs && npm run import:bambu-catalogue && npm run import:pa6 && npm run import:types && npm run import:sunlu && npm run import:ultrafuse && npm run import:fiberlogy && npm run import:spectrum && npm run import:fillamentum && npm run import:addnorth && npm run derive:chemicals && npm run derive:xxl && npm run derive:flame && npm run derive:price && npm run apply:field",
    "import:3djake": "node scripts/import/3djake.mjs",
    "import:m4p": "node scripts/import/material4print.mjs",
    "import:bambu-catalogue": "node scripts/import/bambu-catalogue.mjs",
    "import:usecases": "node scripts/import/usecases.mjs",
    "import:chemicals": "node scripts/import/chemicals.mjs",
    "derive:chemicals": "node scripts/derive-chemical-resistance.mjs",
    "import:glossary": "node scripts/import/glossary.mjs",
    "import:sunlu": "node scripts/import/sunlu.mjs",
    "import:ultrafuse": "node scripts/import/ultrafuse.mjs",
    "import:pa6": "node scripts/import/pa6.mjs",
    "import:fiberlogy": "node scripts/import/fiberlogy.mjs",
    "import:spectrum": "node scripts/import/spectrum.mjs",
    "import:types": "node scripts/import/types-commodity.mjs",
    "import:fillamentum": "node scripts/import/fillamentum.mjs",
    "import:addnorth": "node scripts/import/addnorth.mjs",
    "derive:xxl": "node scripts/derive-xxl-effort.mjs",
    "derive:flame": "node scripts/derive-flame-from-products.mjs",
    "derive:price": "node scripts/derive-price.mjs",
    "apply:field": "node scripts/apply-field-experience.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
