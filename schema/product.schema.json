{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reents3d.github.io/fdm-material-advisor/schema/product.schema.json",
  "title": "Manufacturer Product",
  "description": "Ein konkretes Handelsprodukt einer Marke mit eigenem Datenblatt, verknuepft mit einem Werkstofftyp aus data/materials.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "materialId",
    "brand",
    "manufacturer",
    "productName",
    "specimenType",
    "datasheet",
    "properties",
    "governance"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "materialId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "brand": {
      "type": "string"
    },
    "manufacturer": {
      "type": "string"
    },
    "productName": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "specimenType": {
      "description": "printed = an GEDRUCKTEN Pruefkoerpern gemessen (fuer FDM aussagekraeftig). moulded = Rohstoffkennwerte, spritzgegossen (fuer ein gedrucktes Bauteil nicht erreichbar). undeclared = Datenblatt sagt es nicht. Werte unterschiedlicher specimenType duerfen NICHT direkt verglichen werden.",
      "enum": [
        "printed",
        "moulded",
        "undeclared"
      ]
    },
    "specimenNote": {
      "$ref": "#/$defs/i18n"
    },
    "features": {
      "$ref": "#/$defs/i18n"
    },
    "sharedLineage": {
      "type": "object",
      "description": "Dieses Produkt teilt seine Messung mit Produkten ANDERER Marken - typischerweise, weil ein Compoundeur mehrere Marken beliefert und alle die Tabelle des Lieferanten weitergeben. Die zifferngleichen Werte tragen die Konfidenz `low`, weil sie kein zweiter Beleg sind: Zwei Marken mit derselben Messung sind ein Beleg. Gesetzt von scripts/derive-lineage.ts, siehe ADR-038.",
      "required": [
        "with",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "with": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Produkt-IDs anderer Marken mit derselben Messung."
        },
        "sharedFields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Feldnamen, deren Werte zifferngleich sind."
        },
        "note": {
          "$ref": "#/$defs/i18n"
        }
      }
    },
    "datasheet": {
      "type": "object",
      "required": [
        "title",
        "url",
        "retrievedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "Nur http(s). Ein javascript:- oder data:-Schema wuerde als blosser String die Pruefung passieren und landet in der Oberflaeche als anklickbares href - dieses Projekt nimmt Datenbeitraege per Pull Request an, und wer Werkstoffwerte fachlich gegenliest, sieht ein Schema in einer Quellenangabe nicht."
        },
        "version": {
          "type": "string"
        },
        "retrievedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "productUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "Nur http(s). Ein javascript:- oder data:-Schema wuerde als blosser String die Pruefung passieren und landet in der Oberflaeche als anklickbares href - dieses Projekt nimmt Datenbeitraege per Pull Request an, und wer Werkstoffwerte fachlich gegenliest, sieht ein Schema in einer Quellenangabe nicht."
    },
    "properties": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "value",
          "unit",
          "source",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "tolerance": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "testStandard": {
            "type": "string"
          },
          "orientation": {
            "enum": [
              "XY",
              "XZ",
              "Z",
              "isotropic",
              "n/a"
            ]
          },
          "conditions": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "estimated"
            ]
          },
          "note": {
            "$ref": "#/$defs/i18n"
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "required": [
        "lastReviewed",
        "reviewedBy",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "lastReviewed": {
          "type": "string"
        },
        "reviewedBy": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "chemicalResistance": {
      "description": "Bestaendigkeitsangaben AUS DEM DATENBLATT dieses Produkts. Bewusst getrennt von der abgeleiteten Familienmatrix am Werkstofftyp: eine Herstellerangabe zu einem konkreten Produkt ist eine andere Aussage als eine Ableitung aus der Polymerfamilie.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chemicalId",
          "rating",
          "source",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "chemicalId": {
            "type": "string",
            "pattern": "^chem_[a-z0-9_]+$"
          },
          "rating": {
            "enum": [
              "resistant",
              "limited",
              "not-resistant",
              "unknown"
            ]
          },
          "conditions": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "estimated"
            ]
          },
          "note": {
            "type": "object",
            "required": [
              "de",
              "en"
            ],
            "properties": {
              "de": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "compliance": {
      "description": "Regulatorische Angaben aus dem Produktdatenblatt.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ul94": {
          "type": "object",
          "required": [
            "value",
            "source",
            "confidence"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "enum": [
                "V-0",
                "V-1",
                "V-2",
                "5VA",
                "5VB",
                "HB",
                null
              ]
            },
            "thicknessMm": {
              "type": "number"
            },
            "testStandard": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low",
                "estimated"
              ]
            },
            "note": {
              "type": "object",
              "required": [
                "de",
                "en"
              ],
              "properties": {
                "de": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "required": [
        "de",
        "en"
      ],
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
