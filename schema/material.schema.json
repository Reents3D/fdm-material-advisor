{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reents3d.github.io/fdm-materialberater/schema/material.schema.json",
  "title": "FDM Material Record",
  "description": "Ein Datensatz beschreibt genau EINE Materialvariante (z. B. PETG-CF), nicht ein Handelsprodukt eines Herstellers. Jede Sachaussage ist ein Wertobjekt mit Quelle und Konfidenz. Fehlende Felder sind erlaubt und erwuenscht - erfundene Werte nicht.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "identity",
    "governance"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "mechanics": {
      "$ref": "#/$defs/mechanics"
    },
    "thermal": {
      "$ref": "#/$defs/thermal"
    },
    "processing": {
      "$ref": "#/$defs/processing"
    },
    "durability": {
      "$ref": "#/$defs/durability"
    },
    "compliance": {
      "$ref": "#/$defs/compliance"
    },
    "sustainability": {
      "$ref": "#/$defs/sustainability"
    },
    "finishing": {
      "$ref": "#/$defs/finishing"
    },
    "commercial": {
      "$ref": "#/$defs/commercial"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "i18nText": {
      "type": "object",
      "required": [
        "de",
        "en"
      ],
      "propertyNames": {
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "description": "high = mehrere unabhaengige Primaerquellen oder eine belastbare Normpruefung. medium = eine Primaerquelle oder gut uebereinstimmende Sekundaerquellen. low = Quelle vorhanden, aber zweifelhaft, widerspruechlich oder unspezifisch. estimated = keine Quelle, fachliche Ableitung - MUSS in der UI sichtbar gekennzeichnet werden.",
      "enum": [
        "high",
        "medium",
        "low",
        "estimated"
      ]
    },
    "sourceRef": {
      "description": "Eine oder mehrere Quellen-IDs. Aufloesbar gegen governance.sources[] der Datei oder gegen data/sources.json. Sonderwerte: estimate_reasoning (fachliche Schaetzung), field_experience_reents (eigene Fertigungserfahrung), vendor_claim_unverified (Herstelleraussage ohne Pruefbeleg).",
      "oneOf": [
        {
          "$ref": "#/$defs/sourceId"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceId"
          }
        }
      ]
    },
    "sourceId": {
      "type": "string",
      "pattern": "^(src_[a-z0-9_]+|estimate_reasoning|field_experience_reents|vendor_claim_unverified)$"
    },
    "orientation": {
      "description": "Belastungsrichtung relativ zur Bauteilorientierung im Druck. Ohne Orientierung ist ein FDM-Festigkeitswert wertlos.",
      "enum": [
        "XY",
        "XZ",
        "Z",
        "isotropic",
        "n/a"
      ]
    },
    "unit": {
      "enum": [
        "MPa",
        "%",
        "°C",
        "kJ/m²",
        "g/cm³",
        "g/10min",
        "€/kg",
        "mm",
        "mm/s",
        "h",
        "%RH",
        "Ω",
        "Ω/sq",
        "Ω·cm",
        "1e-6/K",
        "W/(m·K)",
        "-",
        "°",
        "a",
        "kg CO2e/kg",
        "Shore D",
        "kg"
      ]
    },
    "quantity": {
      "description": "Wertobjekt fuer jede messbare Groesse. value = typischer Wert (ggf. redaktionell aggregiert). min/max = realistische Spanne UEBER HERSTELLER HINWEG. tolerance = Streuung EINER Quelle (+/-).",
      "type": "object",
      "required": [
        "value",
        "unit",
        "source",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "testStandard": {
          "type": "string",
          "minLength": 2
        },
        "orientation": {
          "$ref": "#/$defs/orientation"
        },
        "conditions": {
          "type": "string",
          "minLength": 2
        },
        "source": {
          "$ref": "#/$defs/sourceRef"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "$ref": "#/$defs/i18nText"
        }
      }
    },
    "qMPa": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "MPa"
            }
          }
        }
      ]
    },
    "qPct": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "%"
            }
          }
        }
      ]
    },
    "qDegC": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "°C"
            }
          }
        }
      ]
    },
    "qImpact": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "kJ/m²"
            }
          }
        }
      ]
    },
    "qDens": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "g/cm³"
            }
          }
        }
      ]
    },
    "qMm": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "mm"
            }
          }
        }
      ]
    },
    "qKg": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "kg"
            }
          }
        }
      ]
    },
    "qMmS": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "mm/s"
            }
          }
        }
      ]
    },
    "qHours": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "h"
            }
          }
        }
      ]
    },
    "qRH": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "%RH"
            }
          }
        }
      ]
    },
    "qEurKg": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "€/kg"
            }
          }
        }
      ]
    },
    "qFactor": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "-"
            }
          }
        }
      ]
    },
    "qYears": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "a"
            }
          }
        }
      ]
    },
    "qDeg": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "°"
            }
          }
        }
      ]
    },
    "qOhmSq": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "Ω/sq"
            }
          }
        }
      ]
    },
    "qCLTE": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "1e-6/K"
            }
          }
        }
      ]
    },
    "qWmK": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "W/(m·K)"
            }
          }
        }
      ]
    },
    "qMFR": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "g/10min"
            }
          }
        }
      ]
    },
    "qCO2e": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "properties": {
            "unit": {
              "const": "kg CO2e/kg"
            }
          }
        }
      ]
    },
    "qMechMPa": {
      "description": "Mechanische Kennwerte MUESSEN eine Orientierung tragen.",
      "allOf": [
        {
          "$ref": "#/$defs/qMPa"
        },
        {
          "required": [
            "orientation"
          ]
        }
      ]
    },
    "qMechPct": {
      "allOf": [
        {
          "$ref": "#/$defs/qPct"
        },
        {
          "required": [
            "orientation"
          ]
        }
      ]
    },
    "qMechImpact": {
      "allOf": [
        {
          "$ref": "#/$defs/qImpact"
        },
        {
          "required": [
            "orientation"
          ]
        }
      ]
    },
    "ratingScale": {
      "description": "Benannte 1-5-Skala. Die Polaritaet (ist 5 gut oder schlecht?) ist NICHT im Datensatz gespeichert, sondern zentral in DATA_MODEL.md und src/engine/scales.ts definiert. validate-data.ts prueft, dass jede hier verwendete Skala dort eine Polaritaet hat.",
      "enum": [
        "printability",
        "warpingTendency",
        "hygroscopy",
        "layerAdhesion",
        "abrasiveness",
        "stringingTendency",
        "creepTendency",
        "notchSensitivity",
        "toughness",
        "fatigueResistance",
        "uvResistance",
        "weatherResistance",
        "hydrolysisResistance",
        "yellowingTendency",
        "stressCrackingSensitivity",
        "gasBarrier",
        "surfaceQuality",
        "sandability",
        "fillability",
        "paintAdhesion",
        "wrappingSuitability",
        "bondability",
        "layerLineVisibility",
        "priceIndex",
        "availability",
        "batchConsistency",
        "dimensionalAccuracy",
        "wearResistance",
        "smallSeriesSuitability",
        "distortionRisk",
        "ralAccuracy"
      ]
    },
    "rating": {
      "type": "object",
      "required": [
        "value",
        "scale",
        "source",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "scale": {
          "$ref": "#/$defs/ratingScale"
        },
        "source": {
          "$ref": "#/$defs/sourceRef"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "note": {
          "$ref": "#/$defs/i18nText"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "flag": {
      "description": "Tri-state Boolean. value: null bedeutet AUSDRUECKLICH unbekannt - nicht false.",
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/sourceRef"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "note": {
          "$ref": "#/$defs/i18nText"
        }
      }
    },
    "choice": {
      "type": "object",
      "required": [
        "value",
        "source",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/sourceRef"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "note": {
          "$ref": "#/$defs/i18nText"
        }
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "name",
        "family",
        "polymerClass",
        "variant",
        "abstract",
        "positioning"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "family": {
          "enum": [
            "PLA",
            "PETG",
            "PET",
            "ABS",
            "ASA",
            "PC",
            "PA",
            "PP",
            "PE",
            "TPU",
            "TPC",
            "PEBA",
            "HIPS",
            "PVC",
            "PVA",
            "BVOH",
            "POM",
            "PMMA",
            "PVDF",
            "PPS",
            "PSU",
            "PPSU",
            "PEI",
            "PEEK",
            "PEKK",
            "PPA",
            "PHA",
            "BLEND",
            "SUPPORT",
            "METAL-FILLED",
            "CERAMIC-FILLED",
            "OTHER"
          ]
        },
        "polymerClass": {
          "enum": [
            "amorphous",
            "semi-crystalline",
            "elastomer",
            "mixed",
            "unknown"
          ]
        },
        "variant": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "basic",
              "tough",
              "high-speed",
              "high-temp",
              "CF",
              "GF",
              "AF",
              "FR",
              "ESD",
              "conductive",
              "low-weight",
              "foaming",
              "recycled",
              "blend",
              "semi-rigid",
              "bio-blend",
              "matte",
              "silk",
              "translucent",
              "antibacterial",
              "support",
              "metal-filled",
              "wood-filled",
              "glow",
              "flexible"
            ]
          }
        },
        "filler": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "carbon-fibre-chopped",
                "carbon-fibre-continuous",
                "glass-fibre",
                "aramid",
                "mineral",
                "wood",
                "metal",
                "ceramic",
                "none",
                "other"
              ]
            },
            "massFractionPct": {
              "$ref": "#/$defs/qPct"
            }
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trademarkNotice": {
          "$ref": "#/$defs/i18nText"
        },
        "abstract": {
          "$ref": "#/$defs/i18nText"
        },
        "positioning": {
          "$ref": "#/$defs/i18nText"
        },
        "notToBeConfusedWith": {
          "description": "Materialien, die im Markt regelmaessig verwechselt werden. Verhindert Fehlentscheidungen und Datenvermischung.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "materialId",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "materialId": {
                "$ref": "#/$defs/slug"
              },
              "reason": {
                "$ref": "#/$defs/i18nText"
              }
            }
          }
        }
      }
    },
    "mechanics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "density": {
          "$ref": "#/$defs/qDens"
        },
        "tensileStrengthXy": {
          "$ref": "#/$defs/qMechMPa"
        },
        "tensileStrengthZ": {
          "$ref": "#/$defs/qMechMPa"
        },
        "tensileModulusXy": {
          "$ref": "#/$defs/qMechMPa"
        },
        "tensileModulusZ": {
          "$ref": "#/$defs/qMechMPa"
        },
        "elongationAtBreakXy": {
          "$ref": "#/$defs/qMechPct"
        },
        "elongationAtBreakZ": {
          "$ref": "#/$defs/qMechPct"
        },
        "flexuralStrengthXy": {
          "$ref": "#/$defs/qMechMPa"
        },
        "flexuralStrengthZ": {
          "$ref": "#/$defs/qMechMPa"
        },
        "flexuralModulusXy": {
          "$ref": "#/$defs/qMechMPa"
        },
        "flexuralModulusZ": {
          "$ref": "#/$defs/qMechMPa"
        },
        "charpyNotchedXy": {
          "$ref": "#/$defs/qMechImpact"
        },
        "charpyUnnotchedXy": {
          "$ref": "#/$defs/qMechImpact"
        },
        "charpyUnnotchedZ": {
          "$ref": "#/$defs/qMechImpact"
        },
        "izodNotchedXy": {
          "$ref": "#/$defs/qMechImpact"
        },
        "compressiveStrength": {
          "$ref": "#/$defs/qMPa"
        },
        "hardnessShoreD": {
          "allOf": [
            {
              "$ref": "#/$defs/quantity"
            },
            {
              "properties": {
                "unit": {
                  "const": "Shore D"
                }
              }
            }
          ]
        },
        "anisotropyFactorTensile": {
          "description": "Z-Zugfestigkeit geteilt durch XY-Zugfestigkeit. MUSS aus Werten DERSELBEN Quelle abgeleitet werden, sonst ist die Zahl Unsinn.",
          "allOf": [
            {
              "$ref": "#/$defs/qFactor"
            },
            {
              "required": [
                "derivedFrom"
              ]
            }
          ]
        },
        "anisotropyFactorImpact": {
          "allOf": [
            {
              "$ref": "#/$defs/qFactor"
            },
            {
              "required": [
                "derivedFrom"
              ]
            }
          ]
        },
        "toughness": {
          "$ref": "#/$defs/rating"
        },
        "creepTendency": {
          "$ref": "#/$defs/rating"
        },
        "fatigueResistance": {
          "$ref": "#/$defs/rating"
        },
        "notchSensitivity": {
          "$ref": "#/$defs/rating"
        },
        "wearResistance": {
          "$ref": "#/$defs/rating"
        }
      }
    },
    "thermal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hdtA": {
          "$ref": "#/$defs/qDegC"
        },
        "hdtB": {
          "$ref": "#/$defs/qDegC"
        },
        "vicatB50": {
          "$ref": "#/$defs/qDegC"
        },
        "glassTransition": {
          "$ref": "#/$defs/qDegC"
        },
        "meltingTemperature": {
          "$ref": "#/$defs/qDegC"
        },
        "continuousServiceTemperature": {
          "$ref": "#/$defs/qDegC"
        },
        "recommendedMaxServiceTemperature": {
          "description": "Eigene, konservative Einsatzempfehlung (unbelastet, Luft). Bewusst getrennt von Herstellerangaben.",
          "$ref": "#/$defs/qDegC"
        },
        "shortTermTemperature": {
          "$ref": "#/$defs/qDegC"
        },
        "minServiceTemperature": {
          "$ref": "#/$defs/qDegC"
        },
        "clte": {
          "$ref": "#/$defs/qCLTE"
        },
        "thermalConductivity": {
          "$ref": "#/$defs/qWmK"
        },
        "annealing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "possible": {
              "$ref": "#/$defs/flag"
            },
            "requiredForDatasheetValues": {
              "description": "true = die Kennwerte dieses Datensatzes wurden an getemperten Pruefkoerpern ermittelt und sind ohne Temperofen NICHT erreichbar.",
              "$ref": "#/$defs/flag"
            },
            "temperature": {
              "$ref": "#/$defs/qDegC"
            },
            "duration": {
              "$ref": "#/$defs/qHours"
            },
            "hdtGain": {
              "$ref": "#/$defs/qDegC"
            },
            "distortionRisk": {
              "$ref": "#/$defs/rating"
            },
            "note": {
              "$ref": "#/$defs/i18nText"
            }
          }
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nozzleTemperature": {
          "$ref": "#/$defs/qDegC"
        },
        "bedTemperature": {
          "$ref": "#/$defs/qDegC"
        },
        "chamberRequirement": {
          "allOf": [
            {
              "$ref": "#/$defs/choice"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "not-required",
                    "recommended",
                    "mandatory",
                    null
                  ]
                }
              }
            }
          ]
        },
        "chamberTemperature": {
          "$ref": "#/$defs/qDegC"
        },
        "dryingTemperature": {
          "$ref": "#/$defs/qDegC"
        },
        "dryingTime": {
          "$ref": "#/$defs/qHours"
        },
        "maxResidualHumidity": {
          "$ref": "#/$defs/qRH"
        },
        "hygroscopy": {
          "$ref": "#/$defs/rating"
        },
        "warpingTendency": {
          "$ref": "#/$defs/rating"
        },
        "shrinkage": {
